{
  "name": "farmjam",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:editor": "vite --host 127.0.0.1 --port 5175 --strictPort --open /__editor",
    "build": "vite build",
    "preview": "vite preview",
    "icons:generate": "node scripts/generate-pwa-icons.mjs",
    "test": "node --test tests/*.test.js",
    "test:editor": "node --test tests/visualOverrides.test.js tests/visualEditorServer.test.js tests/responsiveVisuals.test.js tests/svgEditing.test.js && playwright test --config=playwright.editor.config.js",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test e2e/lifecycle.spec.js e2e/practice.spec.js e2e/string-voicing.spec.js e2e/children.spec.js e2e/settings.spec.js --project=desktop --project=phone-landscape",
    "test:e2e:release": "playwright test --project=desktop --project=phone-landscape",
    "test:production": "npm run build && npm run test:production:built",
    "test:production:built": "playwright test --config=playwright.production.config.js",
    "samples:download": "node scripts/download-instruments.mjs",
    "scenery:download": "node scripts/download-scene-recordings.mjs",
    "audio:analyze": "node scripts/analyze-audio.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.51.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "svg-pathdata": "^7.2.0",
    "tone": "15.1.22"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@vitejs/plugin-react": "6.1.1",
    "ffmpeg-static": "^5.3.0",
    "vite": "8.3.2",
    "vite-plugin-pwa": "^2.0.0"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
